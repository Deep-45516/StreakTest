package com.example.streaktest

import android.content.Intent
import android.net.Uri
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.provider.Settings
import android.widget.Button
import android.widget.LinearLayout
import android.widget.TextView
import androidx.activity.ComponentActivity
import androidx.core.content.FileProvider
import java.io.File

class MainActivity : ComponentActivity() {

    private val handler = Handler(Looper.getMainLooper())

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val layout = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(48, 100, 48, 48)
        }

        val title = TextView(this).apply {
            text = "Streak Test\n\nTarget: Krisha (krisharkive2)\nShortcut: 💯\n\n1. Enable Accessibility automation.\n2. Tap SEND AUTOMATED TEST."
            textSize = 20f
            setPadding(0, 0, 0, 40)
        }

        val settingsButton = Button(this).apply {
            text = "OPEN ACCESSIBILITY SETTINGS"
            setOnClickListener {
                startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
            }
        }

        val sendButton = Button(this).apply {
            text = "SEND AUTOMATED TEST"
            textSize = 18f
            setOnClickListener {
                sendAutomatedTest()
            }
        }

        layout.addView(title)
        layout.addView(settingsButton)
        layout.addView(sendButton)

        setContentView(layout)
    }

    private fun sendAutomatedTest() {
        /*
         * First bring Snapchat to its main screen.
         * This gives the AccessibilityService a more predictable starting point
         * when Snapchat was previously left on another screen.
         */
        try {
            val launchIntent = packageManager
                .getLaunchIntentForPackage("com.snapchat.android")

            if (launchIntent != null) {
                launchIntent.addFlags(
                    Intent.FLAG_ACTIVITY_NEW_TASK or
                        Intent.FLAG_ACTIVITY_CLEAR_TOP
                )
                startActivity(launchIntent)
            }
        } catch (_: Exception) {
            // Continue to the share step even if Snapchat cannot be launched directly.
        }

        /*
         * Give Snapchat time to become active before sharing the image.
         */
        handler.postDelayed({
            shareImageToSnapchat()
        }, 2500L)
    }

    private fun shareImageToSnapchat() {
        val file = File(cacheDir, "streak_dark.png")

        resources.openRawResource(R.drawable.streak_dark).use { input ->
            file.outputStream().use { output ->
                input.copyTo(output)
            }
        }

        val uri: Uri = FileProvider.getUriForFile(
            this,
            "${packageName}.provider",
            file
        )

        val intent = Intent(Intent.ACTION_SEND).apply {
            type = "image/png"
            putExtra(Intent.EXTRA_STREAM, uri)
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            setPackage("com.snapchat.android")
        }

        try {
            startActivity(intent)
        } catch (_: Exception) {
            val fallback = Intent(Intent.ACTION_SEND).apply {
                type = "image/png"
                putExtra(Intent.EXTRA_STREAM, uri)
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            }

            startActivity(Intent.createChooser(fallback, "Send image with"))
        }
    }

    override fun onDestroy() {
        handler.removeCallbacksAndMessages(null)
        super.onDestroy()
    }
}
